# "mock" (default) runs the in-browser mock backend. "live" sends every request to VITE_NECTAR_API_URL.
VITE_API_MODE=mock

# Nectar API base URL, used only when VITE_API_MODE=live.
VITE_NECTAR_API_URL=http://localhost:3333

# Your builder ID (UUID issued by Nectar when you are registered). Every sign-in from this interface is
# attributed to it unless a ?builderId= link overrides it. Defaults to the demo builder "PerpDesk".
VITE_BUILDER_ID=b1a2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d
